<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for Cloudflare Worker vault synchronization -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Biometric Authentication (Fingerprint & Face unlock) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Floating Shield Overlay permissions -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ReWordApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_reword_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_reword_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReWord"
        tools:targetApi="35">

        <!-- Main UI Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ReWord"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Autofill Authentication Activity (Biometric/Master Password prompt on locked vault) -->
        <activity
            android:name=".service.AutofillAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.ReWord.Translucent" />

        <!-- Floating Shield Credential Picker Dialog -->
        <activity
            android:name=".service.FloatingPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.ReWord.Translucent"
            android:windowSoftInputMode="adjustResize" />

        <!-- System-wide Autofill Service -->
        <service
            android:name=".service.ReWordAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <!-- Floating Shield Overlay Service -->
        <service
            android:name=".service.FloatingShieldService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating shield button for quick password autofill" />
        </service>

        <!-- Quick Settings Tile -->
        <service
            android:name=".service.ReWordTileService"
            android:exported="true"
            android:icon="@drawable/ic_reword_shield"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Accessibility Service for direct field autofill -->
        <service
            android:name=".service.ReWordAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
