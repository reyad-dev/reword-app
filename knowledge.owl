  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/req-app-type">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:47:41.635349+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ReWord is a local-first offline password manager for Windows using Electron with AES encryption.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Desktop password manager - Electron.js</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/req-clipboard">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:22.022349+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IPC-based clipboard write. No auto-clear yet implemented.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clipboard copy for passwords and usernames</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/req-favicon">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:21.649011+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Main process fetches favicon as base64 when URL is added. Displayed as site icon.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Automatic favicon fetch via Google Favicon API</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/req-import-export">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:21.776994+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Export to JSON or styled XLSX. Import from JSON or browser CSV (Chrome, Edge, Firefox, Bitwarden).</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Import/export: JSON backup, XLSX, CSV from browsers</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/req-lock">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:22.285577+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">User can lock vault, clearing masterPassword from memory.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manual vault lock</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/req-master-password">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:15.503165+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">User sets master password on first launch. Supports optional hint. Change master password re-encrypts all stored passwords.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Master password authentication with hint support</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/req-reset">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:22.417466+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Removes all websites, accounts, and master password. Resets to initial state.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Full vault reset - wipes all data</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/req-search">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:21.890884+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Live filtering by website name, URL, or username.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Real-time search across all websites and accounts</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/req-security-model">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:22.141134+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contextIsolation=true, nodeIntegration=false, sandbox=true. IPC via preload bridge only.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Secure Electron: sandboxed renderer, no nodeIntegration</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/req-vault">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:21.503454+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Passwords AES-encrypted with master key via electron-store. Websites group multiple accounts (username, password, notes, timestamps).</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AES-encrypted vault: websites + accounts</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/risk-clipboard">
    <rdf:type rdf:resource="urn:ontolink:Risk" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:57:04.894272+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Copied passwords persist in clipboard indefinitely.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No clipboard auto-clear after password copy</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/risk-hardcoded-key">
    <rdf:type rdf:resource="urn:ontolink:Risk" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:57:04.561423+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Static key reword-secure-key-2026 protects casual access but not reverse engineering.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electron-store encryptionKey is hardcoded in source</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/risk-mem-password">
    <rdf:type rdf:resource="urn:ontolink:Risk" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:57:04.727989+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Memory dump during active session could expose master password.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Master password held in-process memory for session</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/risk-pbkdf2-blocking">
    <rdf:type rdf:resource="urn:ontolink:Risk" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:57:05.044455+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Blocks UI during login/encryption. Should move to worker thread.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PBKDF2 runs synchronously on main process</ol:title>
  </rdf:Description>
