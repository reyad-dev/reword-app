  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/constraint-local-only">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:22.546359+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No cloud sync. All data in electron-store on user machine. External only: favicon fetch.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fully offline / local storage only</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/constraint-windows">
    <rdf:type rdf:resource="urn:ontolink:Requirement" />
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:48:22.670312+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electron-packager targets win32/x64. Build produces Windows .exe package.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Windows platform target (win32/x64)</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/dec-aes-gcm">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">req-security-model</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:57:03.778055+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Authenticated encryption, per-record randomness, PBKDF2-SHA256 key derivation (100k iter).</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AES-256-GCM with per-record random salt+IV</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/dec-electron-store">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">req-vault</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:57:04.095126+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Simpler deployment, no native binaries. Trade-off: full array load on each read.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">electron-store over SQLite for persistence</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/dec-google-favicon">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">req-favicon</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:57:04.409430+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No API key needed, stored as base64 data URI. Falls back gracefully offline.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Google Favicon API for site icons</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/dec-local-storage">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">req-vault</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:57:03.611752+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Privacy-first: passwords never leave device. electron-store on local filesystem.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Local-only storage via electron-store, no cloud</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/dec-no-clipboard-clear">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">req-clipboard</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:57:04.244823+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Passwords copied to clipboard remain indefinitely. Recommended: auto-clear after 30s.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No clipboard auto-clear (known gap)</ol:title>
  </rdf:Description>
  <rdf:Description rdf:about="urn:ontolink:project:reword-3-export/dec-sandbox">
    <rdf:type rdf:resource="urn:ontolink:Decision" />
    <ol:basis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">req-security-model</ol:basis>
    <ol:belongsTo rdf:resource="urn:ontolink:project:reword-3-export" />
    <ol:createdAt rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-10-14T17:57:03.930420+00:00</ol:createdAt>
    <ol:summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Defense-in-depth: renderer has no node access, XSS cannot escalate to system access.</ol:summary>
    <ol:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sandbox + contextIsolation + preload bridge</ol:title>
  </rdf:Description>
